#!/bin/sh
set -e
if [ "$1" = configure ]; then
 mkdir -p /var/mobile/原生播放器/遮罩素材
 chown -R mobile:mobile /var/mobile/原生播放器 2>/dev/null || true
 for D in /var/jb/usr/bin/defaults /usr/bin/defaults; do
  if [ -x "$D" ]; then
   P=/var/mobile/Library/Preferences/com.local.playerexact
   "$D" write "$P" Enabled -bool true || true
   "$D" write "$P" ActivationVersion -string 0.3.1 || true
   "$D" delete "$P" StartupPendingToken 2>/dev/null || true
   "$D" delete "$P" StartupPendingVersion 2>/dev/null || true
   chown mobile:mobile "$P.plist" 2>/dev/null || true
   break
  fi
 done
fi
exit 0
